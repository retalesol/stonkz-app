{
  "name": "@stonkz/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Stonkz terminal. Vite + TypeScript, zero framework.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "css:split": "node scripts/split-css.mjs",
    "css:check": "node scripts/split-css.mjs --check && node scripts/verify-css.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@solana/wallet-standard-features": "^1.4.0",
    "@solana/web3.js": "^1.98.4",
    "@stonkz/shared": "workspace:*",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@walletconnect/universal-provider": "^2.24.0",
    "bs58": "^6.0.0",
    "qrcode-generator": "^2.0.4",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
