# Copy to .env.local. Everything here is public — it ships in the bundle.
# Never put a secret, private key or write-scoped API token in a VITE_ var.

# --- API ---------------------------------------------------------------
# sim | live.
#
# `sim` keeps every number local and never touches a wallet: connecting
# fabricates an address, because a sandbox with no server has nothing for a
# real wallet to authenticate against.
#
# `live` selects src/api/live.ts. Reads (board, candles, trades, holders,
# tape, koth) come from the real API and WS; writes (trade, launch, fee
# claim, tips) are signed by a real wallet through src/wallet/ and broadcast
# for real. Crates/XP hit the server ledger in live mode; staking prepares
# on-chain instructions but awaits program deploy — see docs/real-vs-simulated.md.
VITE_API_MODE=sim
VITE_API_URL=http://localhost:8787
VITE_WS_URL=ws://localhost:8787

# --- Solana ------------------------------------------------------------
# mainnet-beta | devnet | localnet. Also selects the Wallet Standard chain id
# a wallet must advertise (`solana:mainnet`, `solana:devnet`, …) — a
# devnet-only wallet is not offered for a mainnet build.
VITE_CLUSTER=devnet
# Public read RPC. Use a domain-restricted Helius key, not a server key.
# Also the RPC the wallet layer confirms against, and the fallback broadcast
# endpoint for wallets that sign but do not send.
VITE_HELIUS_RPC=https://api.devnet.solana.com
# Alias for VITE_HELIUS_RPC when the read endpoint is not Helius.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_JUPITER=https://lite-api.jup.ag/swap/v1

# --- Deployment record -------------------------------------------------
# dev | main. Selects the block of public/chains.json (written by
# scripts/emit-chains.mjs from programs/*/deployments) the app treats as
# deployed: a net missing from that block shows NOT DEPLOYED and refuses to
# trade. `dev` = Solana devnet, RH testnet, Base Sepolia, Arc capped mainnet.
VITE_ENV=dev

# --- Robinhood Chain ---------------------------------------------------
# Confirmed facts, from docs/robinhood-chain.md: chain id 4663 (0x1237), ETH
# gas, Arbitrum Orbit. The default public RPC is documented by Robinhood as
# "not recommended for production use", so set a dedicated endpoint here.
VITE_RH_CHAIN_ID=4663
VITE_RH_RPC=https://rpc.mainnet.chain.robinhood.com
# Staging RH testnet (46630) — see programs/evm/deployments/46630.json:
# VITE_RH_CHAIN_ID=46630
# VITE_RH_RPC=https://rpc.testnet.chain.robinhood.com
# VITE_RH_EXPLORER=https://explorer.testnet.chain.robinhood.com
# Used for share/verify links and for wallet_addEthereumChain. Keep it a
# config value: the explorer host is a documented phishing-lookalike target
# (docs/robinhood-chain.md §2.3), so it must not be built by string-guessing.
VITE_RH_EXPLORER=https://robinhoodchain.blockscout.com
# Bonding-curve vault — holders tab labels this wallet as CURVE, not WHALE.
# Current addresses live in public/chains.json (redeployed 2026-09-27).
# VITE_RH_LAUNCHPAD_ADDRESS=0xe308287C9A85E2B53F1027a1c589B5e3969928e8
VITE_UNISWAP=https://trade-api.gateway.uniswap.org/v1

# --- Base (Coinbase, OP Stack) -----------------------------------------
# Defaults in src/wallet/chain.ts are Base Sepolia (84532). Mainnet is 8453.
# Contracts: programs/evm/deployments/84532.json.
# VITE_BASE_CHAIN_ID=84532
# VITE_BASE_RPC=https://sepolia.base.org
# VITE_BASE_EXPLORER=https://sepolia.basescan.org
# VITE_BASE_LAUNCHPAD_ADDRESS=0x2f197741C3ca71e3FE885a4F74C0D44e3A774D35

# --- Arc (Circle, EVM L1, USDC gas) --------------------------------------
# Mainnet 5042 is the only Arc there is (the public testnet 5042002 closed on
# 17 Sep 2026). Native USDC carries 18 decimals at the EVM layer, so the
# wallet_addEthereumChain payload declares decimals 18 with symbol USDC. Every
# Arc trade is real funds and is capped at $25 (NET_INFO.ARC.maxTradeUsd).
# RPC / explorer defaults are placeholders until confirmed at docs.arc.io.
# VITE_ARC_CHAIN_ID=5042
# VITE_ARC_RPC=https://rpc.arc.network
# VITE_ARC_EXPLORER=https://explorer.arc.network

# --- Wallets -----------------------------------------------------------
# WalletConnect project id, from https://dashboard.reown.com. REQUIRED for
# Robinhood Chain: Robinhood Wallet is mobile-only and ships no browser
# extension (docs/robinhood-chain.md row 32), so a desktop user can only pair
# over WalletConnect. Left unset, the WalletConnect row in the wallet picker
# renders disabled with that reason shown — it never falls back to a fake
# signer.
VITE_WALLETCONNECT_PROJECT_ID=

# `1` offers the browser-local practice keypair (src/wallet/practice.ts) as a
# selectable wallet, for development with no extension installed. It signs a
# real SIWS/SIWE challenge but broadcasts nothing, so nothing settles, and the
# UI pins a badge saying so for the whole session. A real wallet always
# outranks it. Unset here on purpose: `vite build` fails if this is `1` in a
# production build unless VITE_PRACTICE_WALLET_ACK=1 is also set.
VITE_PRACTICE_WALLET=
VITE_PRACTICE_WALLET_ACK=
