{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/t/:sym",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|Applebot).*"
        }
      ],
      "destination": "https://api.ston.kz/og/t/:sym"
    },
    {
      "source": "/u/:addr",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|Applebot).*"
        }
      ],
      "destination": "https://api.ston.kz/og/u/:addr"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "_note": "Unused: deploys run from the repo root; edit /vercel.json."
}
