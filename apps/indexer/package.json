{
  "name": "@stonkz/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dual-chain event indexer. Two replay cursors (Solana slot + EVM block), read-table ingest, fixture producer.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "start": "tsx src/worker.ts",
    "fixtures": "tsx src/fixtures/cli.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@stonkz/api": "workspace:*",
    "@stonkz/curve-sim": "workspace:*",
    "@stonkz/shared": "workspace:*",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20.19.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
