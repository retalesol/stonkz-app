# Copy to .env for local development. Every value below is also the built-in
# default, so an empty environment boots against `docker compose up`.
# No real keys exist yet — the RPC and oracle clients are injectable and the
# test suite substitutes fakes.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# --- Postgres -----------------------------------------------------------
DATABASE_URL=postgres://stonkz:stonkz@localhost:5432/stonkz
DATABASE_POOL_MAX=10

# --- Redis --------------------------------------------------------------
# Unset or `memory://` uses the in-process fake (single node, no persistence).
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------
# MUST be overridden in production; the API refuses to boot on the dev default.
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000
JWT_ISSUER=https://api.ston.kz
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
NONCE_TTL_SECONDS=300
SIWS_DOMAIN=ston.kz

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=https://ston.kz,https://www.ston.kz,http://localhost:5173,http://localhost:4173

# --- Reverse proxy -------------------------------------------------------
# Number of reverse-proxy hops in front of this process that are trusted to
# append their own observed connecting IP to X-Forwarded-For (see
# src/net/client-ip.ts). Only the last this-many entries of that header are
# ever trusted for rate-limit identity; a client can freely fake anything to
# the left of them. Default of 1 matches Railway's single edge-proxy hop —
# see README.md's "Production deployment" table. Set to 0 if this process is
# ever reachable directly, with no proxy in front.
TRUSTED_PROXY_DEPTH=1

# --- Chains -------------------------------------------------------------
# Optional: the deployment record `scripts/emit-chains.mjs` writes
# (apps/web/public/chains.json). Blank *_LAUNCHPAD_ADDRESS / *_ROUTER_ADDRESS /
# SOLANA_LAUNCHPAD_PROGRAM_ID keys are filled from its STONKZ_ENV block
# (`dev` = test chains + Arc capped mainnet, `main` = production). Explicit
# values below always win.
# STONKZ_CHAINS_FILE=../web/public/chains.json
# STONKZ_ENV=dev
SOLANA_RPC_URL=https://api.devnet.solana.com
# mainnet-beta | devnet | testnet | localnet. SIWS Chain ID follows this
# (`solana:devnet` / `solana:mainnet`). Flip both this and SOLANA_RPC_URL for
# mainnet — no other code change required.
SOLANA_CLUSTER=devnet
# Robinhood Chain facts are confirmed in docs/robinhood-chain.md: mainnet is
# 4663, testnet 46630, gas token ETH.
#
# This public RPC is what Robinhood documents as rate-limited and NOT for
# production. It is the default so a fresh checkout runs; `NODE_ENV=production`
# refuses to boot on it, since a wallet render reads a balance.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Blockscout / RH explorer — live token holders (`GET /tokens/:sym/holders`).
# RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
# RH_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
RH_CHAIN_ID=4663
# Chain ids a SIWE message may name, checked server-side. Keep this to one id
# per environment — accepting staging's id in production is a replay path.
RH_ALLOWED_CHAIN_IDS=4663
RH_NETWORK_LABEL=ROBINHOOD
# After `DeployTestnet.s.sol` on 46630 (see programs/evm/deployments/46630.json):
# RH_CHAIN_ID=46630
# RH_ALLOWED_CHAIN_IDS=46630
# RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
# RH_LAUNCHPAD_ADDRESS=0x2588E500B1e5fCF18253F44b6f2607BF2B14161C
# RH_ROUTER_ADDRESS=0xC4146582Ee47eb390Ff9C16E568b9d4D1b409513
# After SeedWethUsdgV3.s.sol — pin the fee tier and quoter so prepare is atomic:
# RH_V3_FEE_TIER_OVERRIDES=USDG:3000
# RH_V3_QUOTER_ADDRESS=0x...
# RH_V3_FACTORY_ADDRESS=0xdf9e3D6ffaC4513dD7b053212bbECcbCD15ec932
# BASE_MINT_OVERRIDES_RH=WETH:0x7943e237c7F95DA44E0301572D358911207852Fa,USDG:0x7E955252E15c84f5768B83c41a71F9eba181802F

# --- Base (Coinbase, OP Stack) ------------------------------------------
# Defaults are Base Sepolia (84532); mainnet is 8453. Contracts from
# programs/evm/deployments/84532.json. `EVM_ALLOWED_CHAIN_IDS` lists every
# EVM chain id a SIWE message may name; it defaults to [RH_CHAIN_ID, BASE_CHAIN_ID].
# BASE_CHAIN_ID=84532
# BASE_RPC_URL=https://sepolia.base.org
# BASE_EXPLORER=https://sepolia.basescan.org
# BASE_LAUNCHPAD_ADDRESS=0x02032371b6B2173211b8aa0Fa90c216d6a3a4E3A
# BASE_ROUTER_ADDRESS=0x7859eC8639311beFF4b45D543AdE7c650020bcF5
# EVM_ALLOWED_CHAIN_IDS=46630,84532

# --- Arc (Circle, EVM L1, USDC gas) --------------------------------------
# Mainnet 5042 is the only Arc there is (the public testnet 5042002 closed on
# 17 Sep 2026), so every Arc trade is real funds and is capped at
# NET_INFO.ARC.maxTradeUsd (25 USD) by the API. RPC / explorer defaults are
# placeholders until confirmed at docs.arc.io — override them here.
# Nothing is deployed on Arc yet: leave the addresses unset and the API refuses
# Arc trades (`rh_router_required`) and does NOT add 5042 to the SIWE
# allow-list. Setting ARC_LAUNCHPAD_ADDRESS is what adds it (or list it in
# EVM_ALLOWED_CHAIN_IDS explicitly).
# ARC_CHAIN_ID=5042
# ARC_RPC_URL=https://rpc.arc.network
# ARC_EXPLORER=https://explorer.arc.network
# ARC_LAUNCHPAD_ADDRESS=
# ARC_ROUTER_ADDRESS=
# ARC_V3_FEE_TIER_OVERRIDES=
# ARC_V3_FACTORY_ADDRESS=
# ARC_V3_QUOTER_ADDRESS=
# BASE_MINT_OVERRIDES_ARC=
# Dust floor / whale cut in USDC (defaults from @stonkz/shared DEFAULT_DUST /
# DEFAULT_WHALE_CUT).
# DUST_ARC_USDC=1
# WHALE_ARC_USDC=500

# Alert when any chain's indexer lag exceeds this.
MAX_CHAIN_LAG_SECONDS=30
# Approximate block/slot cadence, used to convert cursor drift into seconds.
SOLANA_SLOT_MS=400
RH_BLOCK_MS=2000
BASE_BLOCK_MS=2000
# Arc: ~1s blocks, sub-second finality.
ARC_BLOCK_MS=1000

# --- Price oracle -------------------------------------------------------
# Replaces the hardcoded $214.08 in the footer.
PRICE_ORACLE_URL=https://api.coinbase.com/v2/prices
PRICE_ORACLE_TTL_SECONDS=30

# --- Social / media -----------------------------------------------------
# Pinata JWT for `POST /me/avatar`. Leave unset locally to refuse uploads
# with 503. Gateway host only — no https:// prefix.
# PINATA_JWT=
PINATA_GATEWAY=indigo-hollow-catfish-851.mypinata.cloud

# --- Game ledger --------------------------------------------------------
# Server-only crate RNG. HMAC today; VRF before odds are marketed.
CRATE_HMAC_SECRET=dev-only-crate-secret-change-me-000000000000
DAILY_XP_CAP=25000
DAILY_SP_CAP=25000
# Trades below this native notional award nothing.
DUST_SOL=0.01
DUST_ETH=0.0005
# `whale` achievement cut, in native units.
WHALE_SOL=5
WHALE_ETH=2

# --- X (Twitter) profile lookup -----------------------------------------
# Bearer token for X API v2 `GET /users/by/username/:handle`.
# Without this, GET /x/:handle returns status=unavailable (no mock profiles).
# X_BEARER_TOKEN=
X_CACHE_TTL_SECONDS=3600

# --- Quote cache --------------------------------------------------------
QUOTE_CACHE_TTL_SECONDS=8
