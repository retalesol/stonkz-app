# Copy to .env for local development. Every value below is also the built-in
# default, so an empty environment boots against `docker compose up`.
# No real keys exist yet — the RPC and oracle clients are injectable and the
# test suite substitutes fakes.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# --- Postgres -----------------------------------------------------------
DATABASE_URL=postgres://stonkz:stonkz@localhost:5432/stonkz
DATABASE_POOL_MAX=10

# --- Redis --------------------------------------------------------------
# Unset or `memory://` uses the in-process fake (single node, no persistence).
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------
# MUST be overridden in production; the API refuses to boot on the dev default.
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000
JWT_ISSUER=https://api.ston.kz
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
NONCE_TTL_SECONDS=300
SIWS_DOMAIN=ston.kz

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=https://ston.kz,https://www.ston.kz,http://localhost:5173,http://localhost:4173

# --- Reverse proxy -------------------------------------------------------
# Number of reverse-proxy hops in front of this process that are trusted to
# append their own observed connecting IP to X-Forwarded-For (see
# src/net/client-ip.ts). Only the last this-many entries of that header are
# ever trusted for rate-limit identity; a client can freely fake anything to
# the left of them. Default of 1 matches Railway's single edge-proxy hop —
# see README.md's "Production deployment" table. Set to 0 if this process is
# ever reachable directly, with no proxy in front.
TRUSTED_PROXY_DEPTH=1

# --- Chains -------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Robinhood Chain facts are confirmed in docs/robinhood-chain.md: mainnet is
# 4663, testnet 46630, gas token ETH.
#
# This public RPC is what Robinhood documents as rate-limited and NOT for
# production. It is the default so a fresh checkout runs; `NODE_ENV=production`
# refuses to boot on it, since a wallet render reads a balance.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_CHAIN_ID=4663
# Chain ids a SIWE message may name, checked server-side. Keep this to one id
# per environment — accepting staging's id in production is a replay path.
RH_ALLOWED_CHAIN_IDS=4663
RH_NETWORK_LABEL=ROBINHOOD

# Alert when either chain's indexer lag exceeds this.
MAX_CHAIN_LAG_SECONDS=30
# Approximate block/slot cadence, used to convert cursor drift into seconds.
SOLANA_SLOT_MS=400
RH_BLOCK_MS=2000

# --- Price oracle -------------------------------------------------------
# Replaces the hardcoded $214.08 in the footer.
PRICE_ORACLE_URL=https://api.coinbase.com/v2/prices
PRICE_ORACLE_TTL_SECONDS=30

# --- Game ledger --------------------------------------------------------
# Server-only crate RNG. HMAC today; VRF before odds are marketed.
CRATE_HMAC_SECRET=dev-only-crate-secret-change-me-000000000000
DAILY_XP_CAP=25000
DAILY_SP_CAP=25000
# Trades below this native notional award nothing.
DUST_SOL=0.01
DUST_ETH=0.0005
# `whale` achievement cut, in native units.
WHALE_SOL=5
WHALE_ETH=2

# --- Quote cache --------------------------------------------------------
QUOTE_CACHE_TTL_SECONDS=8
