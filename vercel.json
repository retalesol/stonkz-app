{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @stonkz/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/t/:sym",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|Applebot).*"
        }
      ],
      "destination": "https://api.ston.kz/og/t/:sym"
    },
    {
      "source": "/u/:addr",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|Applebot).*"
        }
      ],
      "destination": "https://api.ston.kz/og/u/:addr"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
