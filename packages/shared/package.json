{
  "name": "@stonkz/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure math, constants, fee split and data-model types shared by web, api and indexer. No DOM, no I/O.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
